{
  "name": "server",
  "version": "1.0.0",
  "description": "FitNova REST API",
  "main": "server.js",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "test": "NODE_ENV=test jest --coverage --runInBand"
  },
  "jest": {
    "testMatch": [
      "**/tests/plans.test.js",
      "**/tests/users.test.js",
      "**/tests/auth.test.js"
    ],
    "setupFiles": [
      "./jest.setup.js"
    ],
    "moduleNameMapper": {
      "@faker-js/faker": "<rootDir>/__mocks__/faker.js"
    },
    "collectCoverageFrom": [
      "routes/users.js",
      "routes/plans.js"
    ]
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@faker-js/faker": "^10.4.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^16.0.0",
    "express": "^4.18.2",
    "graphql": "^16.13.2",
    "graphql-http": "^1.22.4",
    "jsonwebtoken": "^9.0.0",
    "mongoose": "^9.6.1",
    "nodemailer": "^8.0.7",
    "pg": "^8.20.0",
    "pg-hstore": "^2.3.4",
    "resend": "^6.12.4",
    "sequelize": "^6.37.8",
    "sequelize-cli": "^6.6.5",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "jest": "^29.0.0",
    "nodemon": "^3.0.0",
    "supertest": "^6.3.0"
  }
}
